{
  "scenarios": [
    {
      "name": "探索胜利、重开和恢复",
      "steps": [
        {"action":"click","selector":"#advance"},
        {"action":"assert","selector":"#progress","includes":"进度 1 / 3"},
        {"action":"click","selector":"#advance"},
        {"action":"assert","selector":"#health","includes":"体力 2"},
        {"action":"click","selector":"#advance"}
      ],
      "terminal":{"selector":"#status","includes":"探索胜利"},
      "restart":{"action":"click","selector":"#restart"},
      "reset":{"selector":"#progress","includes":"进度 0 / 3"},
      "resumed":{"selector":"#progress","includes":"进度 1 / 3"},
      "persisted":{"selector":"#status","includes":"探索中"}
    },
    {
      "name": "陷阱失败、重开和恢复",
      "steps": [
        {"action":"click","selector":"#advance"},
        {"action":"assert","selector":"#progress","includes":"进度 1 / 3"},
        {"action":"click","selector":"#risk"},
        {"action":"assert","selector":"#health","includes":"体力 0"}
      ],
      "terminal":{"selector":"#status","includes":"探索失败"},
      "restart":{"action":"click","selector":"#restart"},
      "reset":{"selector":"#progress","includes":"进度 0 / 3"},
      "resumed":{"selector":"#progress","includes":"进度 1 / 3"},
      "persisted":{"selector":"#status","includes":"探索中"}
    }
  ]
}
